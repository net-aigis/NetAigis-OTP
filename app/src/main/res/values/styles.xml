<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Banner background is dark — app UI follows Material Dark. -->
    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/secondary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_banner</item>
        <item name="colorOnPrimary">@color/primary</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:windowBackground">@drawable/app_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/on_banner</item>
        <item name="android:textColorSecondary">@color/on_banner_muted</item>
        <item name="editTextColor">@color/on_banner</item>
        <item name="android:editTextColor">@color/on_banner</item>
        <!-- Keep brand buttons fully opaque when disabled (Save/Restore). -->
        <item name="android:disabledAlpha">1.0</item>
    </style>

    <style name="DialogTheme" parent="Theme.Material3.Dark.Dialog">
        <item name="colorPrimary">@color/secondary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_banner</item>
    </style>

    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_weight">0</item>
        <item name="android:background">?android:dividerHorizontal</item>
    </style>

    <style name="DialogButtonLayout">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">0</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:divider">?android:dividerHorizontal</item>
        <item name="android:showDividers">middle</item>
    </style>

    <style name="DialogButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:background">@drawable/brand_button_bg</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@null</item>
    </style>

    <style name="TextAppearance.CategoryTab" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Add/Edit token form: fixed label column + aligned values. -->
    <style name="FormLabel">
        <item name="android:layout_width">@dimen/form_label_width</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center_vertical|end</item>
        <item name="android:paddingEnd">@dimen/form_key_value_gap</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FormEditText" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:minHeight">@dimen/form_row_height</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:textCursorDrawable">@drawable/form_text_cursor</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FormRadioButton" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:button">@drawable/form_radio_button</item>
        <item name="buttonCompat">@drawable/form_radio_button</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">@dimen/space_1</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FormSpinner" parent="Widget.AppCompat.Spinner">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:popupBackground">@color/token_card_background</item>
    </style>

    <style name="FormReadonlyValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:minHeight">@dimen/form_row_height</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textIsSelectable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
    </style>
</resources>


