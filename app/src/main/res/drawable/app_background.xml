<?xml version="1.0" encoding="utf-8"?>
<!--
	Theme windowBackground: Add/Edit frost (#B3F7F9FA) draws over this.
	MainActivity paints logo_watermark_wide itself via FixedScaleBackground;
	this remains the scene behind other transparent screens.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
	<item>
		<shape android:shape="rectangle">
			<solid android:color="@color/paper" />
		</shape>
	</item>
	<item>
		<bitmap
			android:gravity="center"
			android:src="@drawable/logo_watermark_wide"
			android:tileMode="disabled" />
	</item>
</layer-list>
