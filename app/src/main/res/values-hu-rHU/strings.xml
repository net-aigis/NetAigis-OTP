    <string name="issuer_edit_warning">Inkább az aliast módosítsa. A kibocsátó a tokent kiadó szolgáltatás.</string>
    <string name="field_help">Súgó</string>
    <string name="field_help_issuer">A tokent kiadó szolgáltatás neve (például GitHub). Lehetőleg a szolgáltatás által megadott értéket használja; saját névhez az Alias mezőt használja.</string>
    <string name="field_help_account">A tokenhez kapcsolódó fiók neve, általában e-mail-cím vagy felhasználónév.</string>
    <string name="field_help_alias">Opcionális megjelenített név, amely a listában a kibocsátó helyett látható. Ha nincs ikon beállítva, az ikon automatikus kiválasztásánál is ezt használja a rendszer a kibocsátó előtt. Hasznos, ha több token kibocsátója azonos.</string>
    <string name="field_help_category">Opcionális csoport a tokenek listabeli rendszerezéséhez (például Munka vagy Személyes).</string>
    <string name="field_help_icon">Opcionális beépített ikon neve. Egyéni kép hiányában a token bélyegképénél elsőbbséget élvez az Alias és a Kibocsátó értékével szemben.</string>
    <string name="field_help_secret">Base32 kódolású megosztott titok. A szolgáltatás és az alkalmazás ezt használja azonos egyszer használatos kódok létrehozásához. Tartsa titokban.</string>
    <string name="field_help_type">A TOTP néhány másodpercenként új kódot hoz létre (ez a leggyakoribb). A HOTP minden számlálónöveléskor új kódot hoz létre.</string>
    <string name="field_help_digits">Az egyszer használatos kód számjegyeinek száma. A legtöbb szolgáltatás 6 számjegyet használ, néhány 7-et vagy 8-at. Egyeznie kell a szolgáltatás beállításával.</string>
    <string name="field_help_algorithm">A kódok kiszámításához használt HMAC-kivonat (SHA1, SHA256 vagy SHA512). Egyeznie kell a szolgáltatással; általában a SHA1 az alapértelmezett.</string>
    <string name="field_help_interval">TOTP esetén az egyes kódok érvényességi ideje másodpercben. A szokásos érték 30. Egyeznie kell a szolgáltatással.</string>
    <string name="field_help_counter">HOTP esetén a számláló aktuális értéke. Szinkronban kell maradnia a szolgáltatással, különben a kódok nem egyeznek.</string>
