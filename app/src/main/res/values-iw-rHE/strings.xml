    <string name="field_help">עזרה</string>
    <string name="field_help_issuer">שם השירות שהנפיק את האסימון (לדוגמה, GitHub). מומלץ להשתמש בערך שסיפק השירות; לשם משלך, השתמש בכינוי.</string>
    <string name="field_help_account">שם החשבון המקושר לאסימון, בדרך כלל כתובת דוא״ל או שם משתמש.</string>
    <string name="field_help_alias">שם תצוגה אופציונלי שמופיע ברשימה במקום המנפיק. כשלא מוגדר סמל, הכינוי משמש גם להתאמה אוטומטית של סמלים לפני המנפיק. שימושי כשיש כמה אסימונים מאותו מנפיק.</string>
    <string name="field_help_category">קבוצה אופציונלית לארגון האסימונים ברשימה (לדוגמה, עבודה או אישי).</string>
    <string name="field_help_icon">שם אופציונלי של סמל מובנה. כשלא מוגדרת תמונה מותאמת אישית, הסמל מקבל עדיפות על הכינוי והמנפיק בתמונה הממוזערת של האסימון.</string>
    <string name="field_help_secret">סוד משותף בקידוד Base32. השירות והאפליקציה משתמשים בו כדי ליצור קודים חד-פעמיים זהים. יש לשמור עליו בסוד.</string>
    <string name="field_help_type">TOTP יוצר קוד חדש מדי כמה שניות (הסוג הנפוץ ביותר). HOTP יוצר קוד חדש בכל פעם שהמונה מתקדם.</string>
    <string name="field_help_digits">מספר הספרות בקוד החד-פעמי. רוב השירותים משתמשים ב-6 ספרות; חלקם ב-7 או ב-8. הערך חייב להתאים לשירות.</string>
    <string name="field_help_algorithm">גיבוב HMAC לחישוב הקודים (SHA1, SHA256 או SHA512). עליו להתאים לשירות; בדרך כלל ברירת המחדל היא SHA1.</string>
    <string name="field_help_interval">ב-TOTP, מספר השניות שבהן כל קוד תקף. בדרך כלל 30. הערך חייב להתאים לשירות.</string>
    <string name="field_help_counter">ב-HOTP, ערך המונה הנוכחי. יש לשמור עליו מסונכרן עם השירות, אחרת הקודים לא יתאימו.</string>
