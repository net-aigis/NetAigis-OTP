<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/token_card_background"
    android:orientation="vertical">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:fitsSystemWindows="true">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:titleTextColor="@color/primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/image"
            style="?android:borderlessButtonStyle"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/space_1"
            android:contentDescription="@string/icon"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/logo" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include layout="@layout/metadata" />

                <View
                    style="@style/Divider"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp" />

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:shrinkColumns="0"
                    android:stretchColumns="1">

                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/form_row_height"
                        android:minHeight="@dimen/form_row_height">

                        <LinearLayout style="@style/FormLabelCell">
                            <TextView
                                style="@style/FormLabel"
                                android:text="@string/secret" />

                            <ImageButton
                                android:id="@+id/help_secret"
                                style="@style/FormHelpButton" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/secret"
                            style="@style/FormEditText"
                            android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ234567="
                            android:hint="(Base32)"
                            android:inputType="textVisiblePassword|textCapCharacters|textNoSuggestions" />
                    </TableRow>

                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/form_row_height"
                        android:minHeight="@dimen/form_row_height">

                        <LinearLayout style="@style/FormLabelCell">
                            <TextView
                                style="@style/FormLabel"
                                android:text="@string/type" />

                            <ImageButton
                                android:id="@+id/help_type"
                                style="@style/FormHelpButton" />
                        </LinearLayout>

                        <RadioGroup
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatRadioButton
                                android:id="@+id/totp"
                                style="@style/FormRadioButton"
                                android:checked="true"
                                android:text="TOTP" />

                            <androidx.appcompat.widget.AppCompatRadioButton
                                android:id="@+id/hotp"
                                style="@style/FormRadioButton"
                                android:text="HOTP" />
                        </RadioGroup>
                    </TableRow>

                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/form_row_height"
                        android:minHeight="@dimen/form_row_height">

                        <LinearLayout style="@style/FormLabelCell">
                            <TextView
                                style="@style/FormLabel"
                                android:text="@string/digits" />

                            <ImageButton
                                android:id="@+id/help_digits"
                                style="@style/FormHelpButton" />
                        </LinearLayout>

                        <RadioGroup
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <androidx.appcompat.widget.AppCompatRadioButton
                                android:id="@+id/digits5"
                                style="@style/FormRadioButton"
                                android:text="@string/five" />

                            <androidx.appcompat.widget.AppCompatRadioButton
                                android:id="@+id/digits6"
                                style="@style/FormRadioButton"
                                android:checked="true"
                                android:text="@string/six" />

                            <androidx.appcompat.widget.AppCompatRadioButton
                                android:id="@+id/digits7"
                                style="@style/FormRadioButton"
                                android:text="@string/seven" />

                            <androidx.appcompat.widget.AppCompatRadioButton
                                android:id="@+id/digits8"
                                style="@style/FormRadioButton"
                                android:text="@string/eight" />
                        </RadioGroup>
                    </TableRow>

                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/form_row_height"
                        android:minHeight="@dimen/form_row_height">

                        <LinearLayout style="@style/FormLabelCell">
                            <TextView
                                style="@style/FormLabel"
                                android:text="@string/algorithm" />

                            <ImageButton
                                android:id="@+id/help_algorithm"
                                style="@style/FormHelpButton" />
                        </LinearLayout>

                        <Spinner
                            android:id="@+id/algorithm"
                            style="@style/FormSpinner" />
                    </TableRow>

                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/form_row_height"
                        android:minHeight="@dimen/form_row_height">

                        <LinearLayout style="@style/FormLabelCell">
                            <TextView
                                style="@style/FormLabel"
                                android:text="@string/interval" />

                            <ImageButton
                                android:id="@+id/help_interval"
                                style="@style/FormHelpButton" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/interval"
                            style="@style/FormEditText"
                            android:inputType="number"
                            android:text="30" />
                    </TableRow>

                    <TableRow
                        android:id="@+id/counter_row"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/form_row_height"
                        android:minHeight="@dimen/form_row_height"
                        android:visibility="gone">

                        <LinearLayout style="@style/FormLabelCell">
                            <TextView
                                style="@style/FormLabel"
                                android:text="@string/counter" />

                            <ImageButton
                                android:id="@+id/help_counter"
                                style="@style/FormHelpButton" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/counter"
                            style="@style/FormEditText"
                            android:inputType="numberDecimal"
                            android:text="0" />
                    </TableRow>
                </TableLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <View style="@style/Divider" />

    <LinearLayout
        android:id="@+id/button_layout"
        style="@style/DialogButtonLayout">

        <Button
            android:id="@+id/cancel"
            style="@style/DialogButton"
            android:text="@android:string/cancel" />

        <Button
            android:id="@+id/add"
            style="@style/DialogButton"
            android:text="@string/add" />
    </LinearLayout>
</LinearLayout>
