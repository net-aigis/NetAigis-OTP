<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/token_card_background"
    android:orientation="vertical">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:fitsSystemWindows="true">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:titleTextColor="@color/primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/metadata" />

            <View
                style="@style/Divider"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/token_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/token_details"
                android:textColor="@color/primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:shrinkColumns="0"
                android:stretchColumns="1">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/form_row_height"
                    android:minHeight="@dimen/form_row_height">

                    <TextView
                        android:id="@+id/algorithm_label"
                        style="@style/FormLabel"
                        android:text="@string/algorithm" />

                    <TextView
                        android:id="@+id/algorithm"
                        style="@style/FormReadonlyValue" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/form_row_height"
                    android:minHeight="@dimen/form_row_height">

                    <TextView
                        android:id="@+id/digits_label"
                        style="@style/FormLabel"
                        android:text="@string/digits" />

                    <TextView
                        android:id="@+id/digits"
                        style="@style/FormReadonlyValue" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/form_row_height">

                    <TextView
                        android:id="@+id/secret_label"
                        style="@style/FormLabel"
                        android:gravity="top|end"
                        android:paddingTop="8dp"
                        android:text="@string/secret" />

                    <TextView
                        android:id="@+id/secret"
                        style="@style/FormReadonlyValue" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/form_row_height"
                    android:minHeight="@dimen/form_row_height">

                    <TextView
                        android:id="@+id/interval_label"
                        style="@style/FormLabel"
                        android:text="@string/interval" />

                    <TextView
                        android:id="@+id/interval"
                        style="@style/FormReadonlyValue" />
                </TableRow>
            </TableLayout>

            <Button
                android:id="@+id/remove_user_token_image"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/brand_button_bg"
                android:text="@string/remove_user_token_image"
                android:textColor="@color/primary" />

            <Button
                android:id="@+id/restore"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/brand_button_bg"
                android:text="@string/restore_defaults"
                android:textColor="@color/primary" />
        </LinearLayout>
    </ScrollView>

    <View style="@style/Divider" />

    <LinearLayout
        android:id="@+id/button_layout"
        style="@style/DialogButtonLayout">
        <Button
            android:id="@+id/cancel"
            style="@style/DialogButton"
            android:text="@android:string/cancel" />

        <Button
            android:id="@+id/save"
            style="@style/DialogButton"
            android:text="@string/save" />
    </LinearLayout>
</LinearLayout>
