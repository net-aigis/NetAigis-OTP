<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:shrinkColumns="0"
    android:stretchColumns="1">

    <TableRow
        android:layout_width="match_parent"
        android:layout_height="@dimen/form_row_height"
        android:minHeight="@dimen/form_row_height">

        <LinearLayout style="@style/FormLabelCell">
            <TextView
                style="@style/FormLabel"
                android:text="@string/issuer" />

            <ImageButton
                android:id="@+id/help_issuer"
                style="@style/FormHelpButton" />
        </LinearLayout>

        <EditText
            android:id="@+id/issuer"
            style="@style/FormEditText"
            android:hint="Example.com"
            android:inputType="textNoSuggestions" />
    </TableRow>

    <TableRow
        android:layout_width="match_parent"
        android:layout_height="@dimen/form_row_height"
        android:minHeight="@dimen/form_row_height">

        <LinearLayout style="@style/FormLabelCell">
            <TextView
                style="@style/FormLabel"
                android:text="@string/account" />

            <ImageButton
                android:id="@+id/help_account"
                style="@style/FormHelpButton" />
        </LinearLayout>

        <EditText
            android:id="@+id/label"
            style="@style/FormEditText"
            android:hint="joe@example.com"
            android:inputType="textNoSuggestions" />
    </TableRow>

    <TableRow
        android:layout_width="match_parent"
        android:layout_height="@dimen/form_row_height"
        android:minHeight="@dimen/form_row_height">

        <LinearLayout style="@style/FormLabelCell">
            <TextView
                style="@style/FormLabel"
                android:text="@string/alias" />

            <ImageButton
                android:id="@+id/help_alias"
                style="@style/FormHelpButton" />
        </LinearLayout>

        <EditText
            android:id="@+id/alias"
            style="@style/FormEditText"
            android:hint="@string/alias"
            android:inputType="textNoSuggestions" />
    </TableRow>

    <TableRow
        android:layout_width="match_parent"
        android:layout_height="@dimen/form_row_height"
        android:minHeight="@dimen/form_row_height">

        <LinearLayout style="@style/FormLabelCell">
            <TextView
                style="@style/FormLabel"
                android:text="@string/category" />

            <ImageButton
                android:id="@+id/help_category"
                style="@style/FormHelpButton" />
        </LinearLayout>

        <AutoCompleteTextView
            android:id="@+id/category"
            style="@style/FormEditText"
            android:completionThreshold="1"
            android:hint="@string/category"
            android:inputType="textNoSuggestions" />
    </TableRow>

    <TableRow
        android:layout_width="match_parent"
        android:layout_height="@dimen/form_row_height"
        android:minHeight="@dimen/form_row_height">

        <LinearLayout style="@style/FormLabelCell">
            <TextView
                style="@style/FormLabel"
                android:text="@string/icon" />

            <ImageButton
                android:id="@+id/help_icon"
                style="@style/FormHelpButton" />
        </LinearLayout>

        <AutoCompleteTextView
            android:id="@+id/icon_key"
            style="@style/FormEditText"
            android:completionThreshold="1"
            android:hint="@string/icon"
            android:inputType="textNoSuggestions" />
    </TableRow>
</TableLayout>
